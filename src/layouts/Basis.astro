---
import '../styles/global.css';

const { titel, omschrijving, pad } = Astro.props;

const siteNaam = 'Vursies van Jan';
const paginaTitel = titel ? `${titel} — ${siteNaam}` : siteNaam;
const huidigPad = pad ?? Astro.url.pathname;

const menu = [
  { naam: 'Vursies', href: '/' },
  { naam: 'Over Jan Bakker', href: '/over-jan-bakker/' },
];

// De voorpagina alleen markeren als je er ook echt op staat; anders zou
// "/" bij elk pad aanslaan.
const actief = (href) =>
  href === '/' ? huidigPad === '/' : huidigPad.startsWith(href);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{paginaTitel}</title>
    {omschrijving && <meta name="description" content={omschrijving} />}
    <meta property="og:title" content={paginaTitel} />
    {omschrijving && <meta property="og:description" content={omschrijving} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <header class="kop">
      <div class="kop__binnen">
        <a class="kop__naam" href="/">{siteNaam}</a>
        <nav>
          {menu.map((item) => (
            <a
              href={item.href}
              aria-current={actief(item.href) ? 'page' : undefined}
            >
              {item.naam}
            </a>
          ))}

          <a
            class="kop__opnames"
            href="https://www.youtube.com/playlist?list=PLXVwaP2NrgA4"
            target="_blank"
            rel="noopener"
            title="Alle opnames op YouTube"
          >
            <svg
              class="kop__opnames-icoon"
              viewBox="0 0 24 24"
              width="17"
              height="17"
              aria-hidden="true"
            >
              <rect
                x="2.4" y="5.4" width="19.2" height="13.2" rx="3.6"
                fill="none" stroke="currentColor" stroke-width="1.7"
              />
              <path d="M10.4 9.3 15.6 12l-5.2 2.7z" fill="currentColor" />
            </svg>
            <span>YouTube</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="omhulsel">
      <slot />
    </main>

    <footer class="voet">
      <div class="omhulsel">
        &copy; {new Date().getFullYear()} Jan Bakker &middot; Vursies in het Urker dialect
      </div>
    </footer>
  </body>
</html>
